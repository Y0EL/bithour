    "pizzip": "^3.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
