    "@emotion/styled": "^11.14.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.25.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.6",
    "docx-pdf": "^0.0.1",
    "docxtemplater": "^3.67.6",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
