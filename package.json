{
  "name": "Crowncare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:core": "next build",
    "build": "bash scripts/build-safe.sh",
    "build:clean": "bash scripts/build-downtime.sh",
    "deploy": "rm -rf .next_old && mv .next .next_old || true && mv .next_new .next && pm2 restart crowncare",
    "init": "npm install && npx prisma generate && npx prisma db push",
    "start": "next start",
    "lint": "eslint"
  },
